# CAREPULSE ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in the real values. DO NOT commit .env to GitHub.

# Flask Secrets
SECRET_KEY=carepulse_super_secret_jwt_and_session_key_2026

# Database Configuration (MySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=carepulse

# SQLite Fallback (Used automatically if MySQL is unreachable)
# SQLITE_DB=carepulse.db

# SMTP Email Dispatch Service
# Ensure you use a 16-character Google App Password (not your normal Gmail password) if using Gmail.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_google_app_password
ALERT_FROM_EMAIL=your_gmail_address@gmail.com
ALERT_EMAIL_ENABLED=true
